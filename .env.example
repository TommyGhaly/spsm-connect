# Carried over from ../Website/.env, renamed EXPO_PUBLIC_* so Expo inlines them.
#
# Everything here is public by design. The Firebase web apiKey is not a secret
# (docs/integrations.md says so outright) - firestore.rules is the protection.
# The Square *access token* is a real secret and is NOT here: it lives in Secret
# Manager and never leaves the Cloud Function.
#
# NOTE: React Native Firebase does NOT read these for its own init. It reads
# google-services.json / GoogleService-Info.plist. These exist for the things
# that talk to Firebase over plain REST (the theme document) and for Square.

EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Read by src/firebase/appCheck.ts. App Attest and Play Integrity both refuse a
# simulator or an unsigned build, so local work needs a debug token registered
# in the Firebase console - see ../Website/docs/gallery-console-setup.md 1d.
# Leave it empty for a real device build; __DEV__ is what selects the provider.
EXPO_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
EXPO_PUBLIC_AZURE_TENANT_ID=
EXPO_PUBLIC_SQUARE_APPLICATION_ID=
EXPO_PUBLIC_SQUARE_LOCATION_ID=
EXPO_PUBLIC_SQUARE_ENVIRONMENT=

EXPO_PUBLIC_API_ORIGIN=https://spsm-database.web.app
