{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "buildConfiguration": "Release",
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APPATTEST_ENV": "development"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "SQUARE_ENV": "production"
      },
      "ios": {
        "buildConfiguration": "Release",
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-simulator": {
      "extends": "production",
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release",
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "5ZRM8X66TN",
        "bundleIdentifier": "org.spsm.connect"
      },
      "android": {
        "applicationId": "org.spsm.connect",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
