{
  "name": "spsm-connect",
  "version": "1.0.0",
  "main": "index",
  "private": true,
  "scripts": {
    "//shared": "The app imports @spsm/shared's compiled dist/, not its TypeScript source. This rebuilds it. The Website repo must be checked out at ../Website.",
    "shared": "npm run build --prefix ../Website/packages/shared",
    "postinstall": "npm run shared",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "//test": "Unit tests, on jest-expo. Only modules that can run without a native runtime are covered — the reporter, the upload failure vocabulary, money. A screen is not tested here; that is what `npm run screenshots` looks at.",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "expo lint",
    "//icons": "Rebuild assets/ from the church seal in ../Website. Run by hand; outputs are committed.",
    "icons": "node scripts/make-icons.mjs",
    "//store": "The store listings' artwork. `screenshots` drives the simulators into store/raw/; `store` draws Play's feature graphic and icon, and conforms whatever raw screenshots exist into store/screenshots/. Run by hand; outputs are committed.",
    "ios:release": "expo run:ios --configuration Release",
    "screenshots": "npm run screenshots:ios && npm run screenshots:android",
    "screenshots:ios": "bash scripts/capture-screenshots.sh",
    "screenshots:android": "bash scripts/capture-screenshots-android.sh",
    "store": "node scripts/make-store-assets.mjs",
    "//clip-cards": "The eight App Clip card images, 1800x1200, into store/clip-cards/. Uploaded by hand in App Store Connect -> Advanced App Clip Experiences, one per experience. Checks its slugs against src/clip/experiences.ts.",
    "clip-cards": "node scripts/make-clip-cards.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.3.3",
    "@react-native-firebase/app-check": "^26.3.3",
    "@react-native-firebase/auth": "^26.3.3",
    "@react-native-firebase/firestore": "^26.3.3",
    "@react-native-firebase/messaging": "^26.3.3",
    "@react-native-firebase/storage": "^26.3.3",
    "@shopify/flash-list": "2.0.2",
    "@spsm/shared": "file:../Website/packages/shared",
    "expo": "~57.0.20",
    "expo-background-task": "~57.0.16",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.19",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.16",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-square-in-app-payments": "^2.1.1",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  }
}
